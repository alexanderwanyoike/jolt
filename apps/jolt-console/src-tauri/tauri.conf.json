{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jolt Console",
  "version": "0.1.0",
  "identifier": "net.jolt.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jolt Console",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "externalBin": ["binaries/jolt"],
    "icon": ["icons/icon.png"]
  }
}
